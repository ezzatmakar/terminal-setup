# ~/.zshrc — interactive zsh: Oh My Zsh + Starship prompt
# Login PATH (Homebrew, Java, Docker) is in ~/.zprofile. API keys are in ~/.zsh_secrets.
# Tools that are not installed are skipped, so this works on a fresh Mac too.

: ${HOMEBREW_PREFIX:=/opt/homebrew}   # set by brew shellenv in ~/.zprofile

# Drop duplicate PATH entries automatically (first occurrence wins).
typeset -U path PATH

# ── Oh My Zsh ────────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                  # prompt comes from Starship (bottom of file)
ZSH_DISABLE_COMPFIX=true      # Homebrew dirs are group-writable; skip compaudit warnings
HIST_STAMPS="yyyy-mm-dd"
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 7

# Extra completions. Must be on fpath before Oh My Zsh runs compinit.
fpath=($HOMEBREW_PREFIX/share/zsh-completions $fpath)

plugins=(git docker docker-compose composer laravel extract sudo colored-man-pages)

# Warp ships its own autosuggestions and syntax highlighting, and these
# line-editor plugins conflict with it. Load them in every other terminal.
if [[ $TERM_PROGRAM != WarpTerminal ]]; then
  plugins+=(zsh-autosuggestions zsh-syntax-highlighting)  # syntax-highlighting must stay last
fi

if [[ -r $ZSH/oh-my-zsh.sh ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  autoload -Uz compinit && compinit   # Oh My Zsh normally runs this
fi

# ── History ──────────────────────────────────────────────────────────────────
HISTSIZE=100000
SAVEHIST=100000
setopt HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS

# ── PHP (Laravel Herd) ───────────────────────────────────────────────────────

# Herd injected PHP binary.
export PATH="$HOME/Library/Application Support/Herd/bin/":$PATH

# Herd injected PHP 8.6 configuration.
export HERD_PHP_86_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/86"

# Herd injected PHP 8.5 configuration.
export HERD_PHP_85_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/85/"

# Herd injected PHP 8.4 configuration.
export HERD_PHP_84_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/84/"

# Herd injected PHP 8.3 configuration.
export HERD_PHP_83_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/83/"

# Herd injected PHP 8.2 configuration.
export HERD_PHP_82_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/82/"

# Herd injected PHP 8.1 configuration.
export HERD_PHP_81_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/81/"

# Herd injected PHP 8.0 configuration.
export HERD_PHP_80_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/80/"

# Herd injected PHP 7.4 configuration.
export HERD_PHP_74_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/74/"

# ── Databases / containers ───────────────────────────────────────────────────
export PATH=/Users/Shared/DBngin/mysql/8.4.2/bin:$PATH

# Docker Desktop's bin dir holds docker-credential-desktop, which config.json's
# "credsStore": "desktop" invokes on every registry pull. Homebrew's docker CLI
# doesn't ship it, so without this any build pulling a base image fails with
# 'docker-credential-desktop: executable file not found in $PATH'.
export PATH="/Applications/Docker.app/Contents/Resources/bin:$PATH"

# ── Ruby / CocoaPods (Homebrew) ──────────────────────────────────────────────
# Kept after Herd/DBngin/Docker so Homebrew's ruby, pod, mysql and docker win.
if [[ -x $HOMEBREW_PREFIX/bin/pod ]]; then
  export PATH="$HOMEBREW_PREFIX/bin:$PATH"
fi

# ── Editors / IDE CLIs ───────────────────────────────────────────────────────

# Added by Antigravity IDE
export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"

# Open a folder or files in Antigravity IDE: `anty .` or `anty file.ts`
anty() {
  if [ "$1" = "." ]; then
    open -a "Antigravity IDE" "$PWD"
  else
    open -a "Antigravity IDE" "$@"
  fi
}

# ── Node.js ──────────────────────────────────────────────────────────────────

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# Add local user binaries (e.g., Claude Code)
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# nvm, loaded fast: `--no-use` skips the slow `nvm use default` (~1s), then the
# default version's bin is put first on PATH directly. Placed after ~/.local/bin
# and pnpm on purpose so nvm's node wins over the copies they bundle.
export NVM_DIR="$HOME/.nvm"
if [[ -r $HOMEBREW_PREFIX/opt/nvm/nvm.sh ]]; then
  source $HOMEBREW_PREFIX/opt/nvm/nvm.sh --no-use
  () {
    [[ -r $NVM_DIR/alias/default ]] || return
    local ver=${$(<$NVM_DIR/alias/default)#v}
    local -a dirs=( $NVM_DIR/versions/node/v${ver}(|.*)(N/nOn) )
    if (( $#dirs )); then
      path=( $dirs[1]/bin $path )
      export NVM_BIN=$dirs[1]/bin NVM_INC=$dirs[1]/include/node
    else
      nvm use default --silent >/dev/null  # alias like lts/*: slower fallback
    fi
  }
  # nvm tab completion (bash script; bashcompinit avoids a second compinit)
  autoload -U +X bashcompinit && bashcompinit
  ZSH_VERSION= source $HOMEBREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm
fi

# ── CLI tools ────────────────────────────────────────────────────────────────
(( $+commands[direnv] )) && eval "$(direnv hook zsh)"

# fzf: Ctrl-R history search, Ctrl-T file picker, Alt-C cd. Warp has its own
# input editor, so the key bindings only apply in other terminals.
if [[ $TERM_PROGRAM != WarpTerminal ]] && (( $+commands[fzf] )); then
  source <(fzf --zsh)
fi

# zoxide: `z proj` jumps to the best-matching directory you've visited.
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# ── Aliases & helpers ────────────────────────────────────────────────────────
alias reload='exec zsh'
alias zshrc='code ~/.zshrc'
alias path='print -l $path'

# Update Oh My Zsh, custom plugins and the prompt/CLI tools in one go.
update-shell() {
  "$ZSH/tools/upgrade.sh"
  local d
  for d in $ZSH_CUSTOM/plugins/*/.git(N:h); do
    git -C "$d" pull --ff-only --quiet && print "updated ${d:t}"
  done
  brew upgrade starship fzf zoxide direnv zsh-completions
}

# ── Secrets (API keys, tokens) — chmod 600, never commit ─────────────────────
[[ -r ~/.zsh_secrets ]] && source ~/.zsh_secrets

# ── Prompt ───────────────────────────────────────────────────────────────────
(( $+commands[starship] )) && eval "$(starship init zsh)"
